{
  "name": "active-md",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run build -w packages/calc -w packages/remark -w packages/runtime && tsc -p packages/calc && tsc -p packages/remark && tsc -p packages/runtime && tsc -p apps/playground",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "release:check": "node scripts/check-release.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
