{
  "name": "@vchernoy/remark-active",
  "version": "0.6.1",
  "description": "A remark plugin for active-md: calc blocks, :input, :value and {{\u2026}} in math",
  "keywords": [
    "remark",
    "remark-plugin",
    "markdown",
    "katex",
    "calculator",
    "active-md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vchernoy/active-md/tree/main/packages/remark#readme",
  "bugs": {
    "url": "https://github.com/vchernoy/active-md/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vchernoy/active-md.git",
    "directory": "packages/remark"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tex": {
      "types": "./dist/tex.d.ts",
      "import": "./dist/tex.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@vchernoy/calc": "0.6.1",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "mdast-util-directive": "3.2.0",
    "mdast-util-math": "3.0.0"
  }
}
