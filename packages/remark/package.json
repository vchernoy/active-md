{
  "name": "@vchernoy/remark-active",
  "version": "0.0.0",
  "description": "A remark plugin for active-md: calc blocks, :input, :value and {{\u2026}} in math",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tex": {
      "types": "./dist/tex.d.ts",
      "import": "./dist/tex.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vchernoy/active-md.git",
    "directory": "packages/remark"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/katex": "0.16.8",
    "@types/mdast": "4.0.4",
    "mdast-util-directive": "3.2.0",
    "mdast-util-math": "3.0.0"
  },
  "dependencies": {
    "@vchernoy/calc": "0.0.0",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  }
}
